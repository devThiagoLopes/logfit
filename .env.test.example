# Variáveis usadas pelos testes (unitários/integração) e pelas migrations
# aplicadas no Postgres do docker-compose.test.yml.
#
# cp .env.test.example .env.test
# npm run test:db:up
# npm run test:db:migrate
# npm test

BETTER_AUTH_SECRET=test-secret-not-for-production
BETTER_AUTH_URL=http://localhost:3000

DATABASE_URL_UNPOOLED=postgres://logfit:logfit@localhost:5433/logfit_test
