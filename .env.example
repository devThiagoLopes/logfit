# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Banco de dados (Neon Postgres via Vercel Marketplace)
# Gerado automaticamente por `vercel env pull .env.local` — não preencher manualmente em dev.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Banco de dados local (docker-compose.yml) — opcional, só se você preferir
# rodar um Postgres local em vez da Neon. Sobrescreve os defaults do compose.
# POSTGRES_USER=logfit
# POSTGRES_PASSWORD=logfit
# POSTGRES_DB=logfit_dev
